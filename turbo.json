{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["content/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "lint", "check"],
      "env": ["MOCK"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["MOCK"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^check"],
      "env": ["MOCK"],
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    }
  }
}
