---
import { entryHref, type SeriesEntry } from '../lib/series';
interface Props {
  series: SeriesEntry;
  wide?: boolean;
}
const { series, wide = false } = Astro.props;
const { title, summary, start, end, status } = series.data;
const dateLabel = (value: Date) =>
  value.toISOString().slice(0, 10).replaceAll('-', '.');
---

<a
  href={entryHref(series)}
  class="group flex min-w-0 items-center gap-3 rounded-lg border border-surface-border bg-linear-to-br from-surface/60 to-surface/20 p-3 transition-colors hocus:border-graph-primary hocus:bg-surface/60"
>
  <span
    class:list={["flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border text-2xl", status === "未开始" ? "border-graph-secondary/30 bg-graph-secondary/15 text-graph-secondary" : "border-graph-primary/30 bg-graph-primary/15 text-graph-primary"]}
    aria-hidden="true"
    ><svg
      viewBox="0 0 24 24"
      class="h-7 w-7"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {status === '进行中' ? <><path d="m5 5 6 6-6 6" /><path d="M13 19h6" /></> : status === '未开始' ? <><path d="M12 5v15M12 5C8 2 4 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-2-1-6-2-10 1Z" /></> : <><path d="m12 3 9 5v8l-9 5-9-5V8l9-5Z" /><path d="m3 8 9 5 9-5M12 13v8" /></>}
    </svg></span
  >
  <div
    class:list={["min-w-0 flex-1", wide && "sm:grid sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-5"]}
  >
    <h4
      class="break-words text-sm font-semibold leading-6 text-page-fg group-hover:text-primary"
    >
      {title}
    </h4>
    <p class="mt-1 break-words text-xs leading-5 text-muted-fg">
      {summary}
    </p>
    <p
      class:list={["ui-mono mt-1.5 text-[11px] text-muted-fg", wide && "sm:col-start-2 sm:row-start-1 sm:row-span-2 sm:self-center sm:mt-0"]}
    >
      <time datetime={start.toISOString()}>{dateLabel(start)}</time>
      {end && <> — <time datetime={end.toISOString()}>{dateLabel(end)}</time></>}
    </p>
  </div>
  <span class="shrink-0 text-graph-primary" aria-hidden="true"
    ><svg
      viewBox="0 0 24 24"
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <path d="m9 5 7 7-7 7" />
    </svg></span
  >
</a>
