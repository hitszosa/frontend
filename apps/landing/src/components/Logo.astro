---
interface LogoItem {
  src: string;
  alt: string;
}

interface Props {
  logos: LogoItem[];
  defaultLogo?: number;
  href: string;
  ariaLabel: string;
  align?: 'start' | 'center' | 'end';
  sizeClass?: string;
}

const {
  logos,
  defaultLogo = 0,
  href,
  ariaLabel,
  align = 'center',
  sizeClass = 'grid-cols-[224px] grid-rows-[224px]',
} = Astro.props;
---

<osa-logo-switcher
  class:list={[
    'group logo-view flex items-center gap-[1em]',
    align === 'center' ? 'justify-center' : align === 'end' ? 'justify-end' : 'justify-start',
  ]}
  data-default-logo={defaultLogo}
>
  <button
    type="button"
    class="opacity-0 group-hover:opacity-100 group-hover:cursor-pointer rounded-full w-8 h-8 text-slate-400 bg-transparent border-none transition-all duration-300 ease-in-out"
  >
    ⏴
  </button>
  <a class:list={['grid', sizeClass]} href={href} aria-label={ariaLabel}>
    {logos.map((logo, index) => (
        <img
          class:list={['logo', { primary: index === defaultLogo }]}
          src={logo.src}
          alt={logo.alt}
        />
      ))}
  </a>
  <button
    type="button"
    class="opacity-0 group-hover:opacity-100 group-hover:cursor-pointer rounded-full w-8 h-8 text-slate-400 bg-transparent border-none transition-all duration-300 ease-in-out"
  >
    ⏵
  </button>
</osa-logo-switcher>

<style>
img.logo {
  grid-area: 1 / 1;
  opacity: 0;
  filter: drop-shadow(0px 18px 9px rgba(0, 0, 0, 0.07)) blur(15px) contrast(3);
  transition: all 0.7s ease-in-out;
  will-change: transform;
}

img.logo.primary {
  opacity: 100%;
  filter: drop-shadow(0px 18px 9px rgba(0, 0, 0, 0.07));
  z-index: 2;
}

img.logo.primary:hover {
  transform: rotate(8deg);
  filter: drop-shadow(0px 12px 6px rgba(0, 0, 0, 0.07));
}
</style>

<script>
class OsaLogoSwitcher extends HTMLElement {
  connectedCallback() {
    const defaultLogo = Number(this.dataset.defaultLogo ?? '0');
    let logoIndex = Number.isNaN(defaultLogo) ? 0 : defaultLogo;

    const logos = this.querySelectorAll('img.logo');
    const buttons = this.querySelectorAll('button');
    const [prevButton, nextButton] = buttons;

    const updateLogos = () => {
      logos.forEach((logo, index) => {
        if (index === logoIndex) {
          logo.classList.add('primary');
        } else {
          logo.classList.remove('primary');
        }
      });
    };

    updateLogos();

    prevButton?.addEventListener('click', () => {
      logoIndex = (logoIndex - 1 + logos.length) % logos.length;
      updateLogos();
    });

    nextButton?.addEventListener('click', () => {
      logoIndex = (logoIndex + 1) % logos.length;
      updateLogos();
    });
  }
}

if (!customElements.get('osa-logo-switcher')) {
  customElements.define('osa-logo-switcher', OsaLogoSwitcher);
}
</script>
