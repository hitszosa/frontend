---
interface Props {
  href: string;
  description: string;
  label?: string;
}

const { href, description, label = '打开链接' } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<aside class="my-8 rounded-lg border border-surface-border bg-surface p-5">
  <p class="m-0! text-sm leading-7 text-muted-fg">{description}</p>
  <a
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noreferrer noopener' : undefined}
    class="group inline-flex font-medium text-primary no-underline"
  >
    <span
      class="underline decoration-transparent decoration-dotted underline-offset-4 transition-colors duration-200 group-hover:decoration-current"
      >{label}</span
    >{external ? ' ↗' : ' →'}
  </a>
</aside>
