---
import type { UpdateEntry } from '../lib/updates';
import Badge from './Badge.astro';
import TagBadges from './TagBadges.astro';
import ContentImage from './content/ContentImage.astro';

interface Props {
  updates: UpdateEntry[];
}

type BadgeTone = 'primary' | 'secondary' | 'success' | 'warning' | 'muted';

const { updates } = Astro.props;
const importantUpdates = updates
  .filter((entry) => entry.importance === 'important')
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);
const primaryUpdate = importantUpdates[0];
const secondaryUpdates = importantUpdates.slice(1);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  }).format(date);
const getTone = (entry: UpdateEntry): BadgeTone =>
  entry.warning
    ? 'warning'
    : entry.kind === 'event'
      ? 'secondary'
      : entry.kind === 'article'
        ? 'success'
        : 'primary';
---

{primaryUpdate && (
    <section id="featured" class="border-b border-surface-border py-14">
      <article data-landing-reveal class="mt-7 flex flex-col overflow-hidden rounded-xl border border-surface-border bg-surface transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md focus-within:border-primary/50 focus-within:shadow-md md:flex-row">
        {primaryUpdate.cover && (
          <div class="flex shrink-0 items-center justify-center border-b border-surface-border bg-inset md:max-w-[60%] md:border-r md:border-b-0">
            <ContentImage
              src={primaryUpdate.cover}
              alt={primaryUpdate.coverAlt ?? primaryUpdate.title}
              class="mx-auto block h-auto max-h-[70vh] w-auto max-w-full md:max-h-[32rem]"
              loading="eager"
            />
          </div>
        )}
        <div class="flex min-w-0 flex-1 flex-col p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-2 text-xs text-muted-fg">
            <Badge tone={getTone(primaryUpdate)}>{primaryUpdate.label}</Badge>
            <TagBadges tags={primaryUpdate.tags} />
            {primaryUpdate.meta && (
              <Badge tone="muted">{primaryUpdate.meta}</Badge>
            )}
            {primaryUpdate.upcoming && (
              <Badge tone="warning" mono>
                即将举行
              </Badge>
            )}
            <time class="ui-mono" datetime={primaryUpdate.date.toISOString()}>
              {formatDate(primaryUpdate.date)}
            </time>
          </div>
          <h2 class="mt-5 text-2xl font-semibold tracking-tight text-surface-fg">
            <a
              href={primaryUpdate.href}
              class="no-underline transition-colors hover:text-primary focus-visible:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              {primaryUpdate.title}
            </a>
          </h2>
          <p class="mt-4 leading-7 text-muted-fg">{primaryUpdate.summary}</p>
          <div class="mt-auto pt-8">
            <a
              href={primaryUpdate.href}
              class="group font-medium text-primary no-underline"
            >
              <span
                class="underline decoration-transparent decoration-dotted underline-offset-4 transition-colors duration-200 group-hover:decoration-current"
                >查看详情</span
              > →
            </a>
          </div>
        </div>
      </article>

      {secondaryUpdates.length > 0 && (
        <div
          class="mt-4 grid gap-4 sm:grid-cols-2"
          data-landing-reveal
          data-landing-stagger
          style="--landing-reveal-delay: 80ms"
        >
          {secondaryUpdates.map((entry) => (
            <a
              href={entry.href}
              class="group flex min-h-28 overflow-hidden rounded-lg border border-surface-border bg-surface no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md focus-visible:border-primary/50 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 focus-visible:shadow-md"
            >
              {entry.cover && (
                <div class="flex shrink-0 max-w-2/5 items-center justify-center border-r border-surface-border bg-inset">
                  <ContentImage
                    src={entry.cover}
                    alt={entry.coverAlt ?? entry.title}
                    class="block h-full w-full object-cover"
                  />
                </div>
              )}
              <div class="min-w-0 flex-1 p-4">
                <div class="flex flex-wrap items-center gap-1.5">
                  <Badge tone={getTone(entry)}>{entry.label}</Badge>
                  <TagBadges tags={entry.tags} />
                  {entry.meta && <Badge tone="muted">{entry.meta}</Badge>}
                  <time
                    class="ui-mono text-[11px] text-muted-fg"
                    datetime={entry.date.toISOString()}
                  >
                    {formatDate(entry.date)}
                  </time>
                </div>
                <h3 class="mt-2 line-clamp-2 font-medium text-surface-fg group-hover:text-primary">
                  {entry.title}
                </h3>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  )}
