---
interface Props {
  tone?: 'primary' | 'secondary' | 'success' | 'warning' | 'info' | 'muted';
  size?: 'sm' | 'md';
  mono?: boolean;
}

const { tone = 'muted', size = 'sm', mono = false } = Astro.props;
const accents = {
  primary: 'var(--ui-primary)',
  secondary: 'var(--ui-secondary)',
  success: 'var(--ui-success, var(--ui-primary))',
  warning: 'var(--ui-activity-fg, var(--ui-secondary))',
  info: 'var(--ui-info-fg, var(--ui-primary))',
  muted: 'var(--ui-surface-fg)',
};
const backgrounds = {
  primary: 'var(--ui-primary)',
  secondary: 'var(--ui-secondary)',
  success: 'var(--ui-success, var(--ui-primary))',
  warning: 'var(--ui-activity, var(--ui-secondary))',
  info: 'var(--ui-info, var(--ui-primary))',
  muted: 'var(--ui-muted-fg)',
};
---

<span
  class:list={[
    'inline-flex shrink-0 items-center rounded font-medium leading-none',
    size === 'sm' ? 'px-1.5 py-0.5 text-[11px]' : 'px-2 py-1 text-xs',
    mono && 'ui-mono font-semibold',
  ]}
  style={`background: color-mix(in srgb, ${backgrounds[tone]} 15%, transparent); color: ${accents[tone]};`}
  ><slot /></span
>
