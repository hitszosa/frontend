---
import SeriesCard from './SeriesCard.astro';
import type { SeriesEntry } from '../lib/series';
interface Props {
  series: SeriesEntry[];
}
const { series } = Astro.props;
const groups = (['进行中', '未开始', '已结束'] as const)
  .map((status) => ({
    status,
    title: status === '未开始' ? '即将开始' : status,
    description:
      status === '进行中'
        ? '正在进行的系列活动'
        : status === '未开始'
          ? '即将开始的系列活动'
          : '已完成的系列活动',
    entries: series
      .filter((entry) => entry.data.status === status)
      .sort(
        (a, b) =>
          (status === '已结束'
            ? (b.data.end ?? b.data.start).getTime() -
              (a.data.end ?? a.data.start).getTime()
            : a.data.start.getTime() - b.data.start.getTime()) ||
          a.id.localeCompare(b.id),
      ),
  }))
  .filter((group) => group.entries.length);
---

{groups.length > 0 && <section class="border-b border-surface-border pb-5" aria-labelledby="series-heading" id="series-activities">
  <div class="flex flex-wrap items-start justify-between gap-6">
  <div>
  <p class="ui-mono text-xs tracking-[0.3em] text-muted-fg">ACTIVITIES</p>
  <h1 id="series-heading" class="mt-2 text-3xl font-bold md:text-4xl text-page-fg">系列活动</h1>
  <p class="mt-2 text-sm text-muted-fg">围绕开源与技术实践，持续组织交流与学习。</p>
  </div>
  <blockquote class="hidden pt-8 text-right text-sm italic leading-7 text-muted-fg lg:block">“ 技术连接彼此，社区创造可能 ”<br /><span class="ui-mono text-xs">— HITSZ OSA</span></blockquote>
  </div>
  <div class="mt-6 grid gap-4">
  {groups.map(({ status, title, description, entries }) => {
    const visible = status === '已结束' ? entries.slice(0, 3) : entries;
    const columns = visible.length === 1 ? '' : visible.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 xl:grid-cols-3';
    return <section class="grid min-w-0 gap-3 border-t border-surface-border/60 pt-4 lg:grid-cols-[8rem_minmax(0,1fr)] lg:gap-5" aria-label={title}>
      <div class="lg:pt-3">
        <h3 class="flex items-center gap-2.5 text-base font-semibold text-page-fg"><span class:list={['h-3 w-3 shrink-0 rounded-full', status === '进行中' ? 'bg-success ring-4 ring-success/10' : status === '未开始' ? 'bg-graph-secondary ring-4 ring-graph-secondary/10' : 'bg-graph-primary ring-4 ring-graph-primary/10']} aria-hidden="true"></span>{title}</h3>
        <p class="mt-2 text-xs leading-5 text-muted-fg">{description}</p>
      </div>
      <div class="min-w-0">
        <div class:list={['grid gap-3', columns]}>
          {visible.map((entry) => <SeriesCard series={entry} wide={visible.length === 1} />)}
        </div>
        {status === '已结束' && entries.length > 3 && <details class="mt-3">
          <summary class="w-fit cursor-pointer rounded text-xs text-primary focus-visible:outline-2 focus-visible:outline-primary">展开其余 {entries.length - 3} 个已结束系列</summary>
          <div class="mt-3 grid gap-3 md:grid-cols-2 xl:grid-cols-3">{entries.slice(3).map((entry) => <SeriesCard series={entry} />)}</div>
        </details>}
      </div>
    </section>;
  })}
  </div>
</section>}
