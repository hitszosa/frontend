---
import TimelineEntry from './TimelineEntry.astro';
import Badge from './Badge.astro';
import { entryHref, formatSeriesDate, type UpdateGroup } from '../lib/series';
interface Props {
  groups: UpdateGroup[];
}
const { groups } = Astro.props;
---

<ul
  class="relative mt-6 before:absolute before:bottom-5 before:left-[5px] before:top-2 before:w-px before:bg-graph-primary/50 md:before:left-[10rem]"
>
  {groups.map((group) => group.kind === 'entry' ? <TimelineEntry entry={group.entry} /> :
    <li class="relative min-w-0 pb-6 pl-7 md:grid md:grid-cols-[9rem_minmax(0,1fr)] md:gap-8 md:pl-0">
      <span class="absolute left-0 top-1.5 h-4 w-4 rounded-full border-2 border-page-bg bg-graph-primary ring-4 ring-graph-primary/10 md:left-[10rem] md:-translate-x-1/2" aria-hidden="true"></span>
      <time class="ui-mono text-xs text-muted-fg md:pt-1" datetime={group.date.toISOString()}>{formatSeriesDate(group.date)}</time>
      <div class="min-w-0">
        <div class="relative">
          <details class="group min-w-0">
            <summary class="flex min-h-6 cursor-pointer list-none flex-wrap items-center gap-x-2 gap-y-1 rounded text-surface-fg focus-visible:outline-2 focus-visible:outline-primary sm:pr-28 [&::-webkit-details-marker]:hidden">
              <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0 text-graph-primary transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
              <span class="break-words text-sm font-semibold">{group.series.data.title}</span>
              <span class="whitespace-nowrap text-xs text-muted-fg">{group.entries.length} 条动态</span>
              {group.pinned && <span class="ml-2"><Badge tone="primary">置顶</Badge></span>}
            </summary>
            <ul class="relative mt-4 before:absolute before:-left-4 before:top-0 before:h-6 before:w-7 before:rounded-bl-3xl before:border-b-2 before:border-l-2 before:border-graph-primary/60">{group.entries.map((entry) => <TimelineEntry entry={entry} nested />)}</ul>
          </details>
          <a href={entryHref(group.series)} class="landing-link ml-6 mt-2 inline-block text-xs sm:absolute sm:right-0 sm:top-0 sm:mt-0"><span class="landing-link-label">查看系列 →</span></a>
        </div>
      </div>
    </li>)}
</ul>
