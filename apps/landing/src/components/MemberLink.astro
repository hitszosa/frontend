---
interface LinkItem {
  name: string;
  description: string;
  href: string;
  type: 'project' | 'website' | 'other';
}

interface Props {
  link: LinkItem;
  author: string;
  github?: string;
  image?: string;
}

const { link, author, github, image } = Astro.props;
const hostname = new URL(link.href).hostname.replace(/^www\./, '');
const showGithubIcon = hostname === 'github.com' && !image;
const iconUrl = image ?? new URL('/favicon.ico', link.href).href;
const initial = Array.from(link.name)[0] ?? '↗';
---

<a
  href={link.href}
  target="_blank"
  rel="noreferrer noopener"
  class="group flex min-w-0 items-center gap-3 rounded-md px-2 py-3 no-underline transition-colors hover:bg-surface"
>
  <span
    class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-md bg-primary/10 text-sm font-semibold text-primary ring-1 ring-surface-border"
  >
    {showGithubIcon ? (
      <span aria-hidden="true" class="inline-flex">
        <iconify-icon
          icon="simple-icons:github"
          class="text-xl text-surface-fg"
        ></iconify-icon>
      </span>
    ) : (
      <>
        <span aria-hidden="true">{initial}</span>
        <img
          src={iconUrl}
          alt={image ? `${link.name} 图标` : ''}
          width="36"
          height="36"
          class:list={[
            'absolute inset-0 h-full w-full bg-surface opacity-0 transition-opacity',
            image ? 'object-cover' : 'object-contain p-1.5',
          ]}
          loading="lazy"
          decoding="async"
          onload="this.style.opacity='1'"
          onerror="this.remove()"
        />
      </>
    )}
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex min-w-0 items-center justify-between gap-3">
      <span
        class="truncate text-sm font-semibold text-surface-fg group-hover:text-primary"
      >
        {link.name}
      </span>
      <span aria-hidden="true" class="shrink-0 text-sm text-primary">↗</span>
    </span>
    {link.description && (
      <span class="mt-1 block truncate text-sm text-surface-fg/80">
        {link.description}
      </span>
    )}
    <span
      class="mt-1.5 flex min-w-0 items-center gap-2 text-xs text-surface-fg/70"
    >
      <span class="shrink-0 font-semibold text-surface-fg">{author}</span>
      <span aria-hidden="true">·</span>
      {hostname === 'github.com' ? (
        <span class="inline-flex shrink-0 items-center" title="GitHub">
          <span aria-hidden="true" class="inline-flex">
            <iconify-icon icon="simple-icons:github" class="text-sm"></iconify-icon>
          </span>
          <span class="sr-only">GitHub</span>
        </span>
      ) : (
        <span class="ui-mono truncate">{hostname}</span>
      )}
      {github && <span class="ui-mono hidden truncate sm:inline">@{github}</span>}
    </span>
  </span>
</a>
