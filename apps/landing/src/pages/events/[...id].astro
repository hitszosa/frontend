---
import '../../styles/content.css';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/LandingLayout.astro';
import Badge from '../../components/Badge.astro';
import RelatedLink from '../../components/content/RelatedLink.astro';
import ContentImage from '../../components/content/ContentImage.astro';
import { contentPath } from '../../lib/content';

export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.hide);
  return events.map((event) => ({
    params: { id: contentPath(event.id) },
    props: { event },
  }));
}

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { Content } = await render(event);
const {
  title,
  date,
  endDate,
  location,
  type,
  summary,
  upcoming,
  cover,
  coverAlt,
} = event.data;
const formatLongDate = (value: Date) =>
  new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(value);
const dateLabel = endDate
  ? `${formatLongDate(date)} — ${formatLongDate(endDate)}`
  : formatLongDate(date);
---

<Layout title={`${title} | HITSZ OSA`} description={summary}>
  <article class="mx-auto max-w-3xl py-12 md:py-16">
    <a href="/updates" class="landing-link group ui-mono text-sm"
      >← <span class="landing-link-label">返回动态</span></a
    >

    {cover && (
      <ContentImage
        src={cover}
        alt={coverAlt ?? title}
        class="mx-auto mt-8 block h-auto max-h-[80vh] w-auto max-w-full rounded-xl border border-surface-border"
        loading="eager"
      />
    )}

    <header class="mt-8 border-b border-surface-border pb-10">
      <div
        class="flex flex-wrap items-center gap-2 ui-mono text-xs text-muted-fg"
      >
        <Badge tone="secondary" size="md">活动</Badge>
        <Badge tone="muted" size="md">{type}</Badge>
        {upcoming && (
            <Badge tone="warning" size="md" mono>
              即将举行
            </Badge>
          )}
      </div>
      <h1
        class="mt-5 text-3xl font-bold leading-tight tracking-tight text-page-fg md:text-5xl"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-fg">{summary}</p>
      <dl class="mt-7 grid gap-4 text-sm sm:grid-cols-2">
        <div class="border-l-2 border-primary pl-4">
          <dt class="ui-mono text-xs text-muted-fg">日期</dt>
          <dd class="mt-1 text-surface-fg">
            <time datetime={date.toISOString()}>{dateLabel}</time>
          </dd>
        </div>
        <div class="border-l-2 border-surface-border pl-4">
          <dt class="ui-mono text-xs text-muted-fg">地点</dt>
          <dd class="mt-1 text-surface-fg">
            {location || '待定'}
          </dd>
        </div>
      </dl>
    </header>

    <div class="content-body mt-10">
      <Content components={{ RelatedLink }} />
    </div>

    <footer class="mt-12 border-t border-surface-border pt-8">
      <a href="/updates" class="landing-link group text-sm"
        ><span class="landing-link-label">查看全部动态</span>
        →</a
      >
    </footer>
  </article>
</Layout>
