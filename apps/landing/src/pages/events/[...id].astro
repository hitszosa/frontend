---
import { getCollection, type CollectionEntry } from 'astro:content';
import EventPage from '../../components/EventPage.astro';
import { contentPath } from '../../lib/content';
export async function getStaticPaths() {
  const events = await getCollection('events', ({ data }) => !data.hide);
  return events.map((event) => ({ params: { id: contentPath(event.id) }, props: { event } }));
}
interface Props { event: CollectionEntry<'events'>; }
const { event } = Astro.props;
---
<EventPage event={event} />
