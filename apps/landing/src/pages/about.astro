---
import Layout from "../layouts/LandingLayout.astro";
import GithubMemberCard from "../components/GithubMemberCard.astro";
import { getCollection } from "astro:content";
import { getGithubOrgMembers } from "../lib/github";

const services = (
  await getCollection("services", ({ data }) => !data.hide)
).sort((a, b) => a.data.order - b.data.order);
const githubMembers = await getGithubOrgMembers();

const socialLinks = [
  {
    name: "GitHub",
    href: "https://github.com/hitszosa",
    label: "@hitszosa",
    icon: "simple-icons:github",
  },
  {
    name: "QQ 群",
    href: "https://qm.qq.com/cgi-bin/qm/qr?k=EmOyWeZrOaOeSoVrVLoozyKYdvjOia_t",
    label: "群 811633021",
    icon: "simple-icons:qq",
  },
  {
    name: "BiliBili",
    href: "https://space.bilibili.com/1124374292",
    label: "HITSZ开源技术协会",
    icon: "simple-icons:bilibili",
  },
];

const campusResources = [
  { name: "上网认证", href: "http://10.248.98.2/" },
  { name: "课程录播平台", href: "http://219.223.238.14:88/ve/" },
];
---

<Layout
  title="关于我们 | HITSZ OSA"
  description="哈尔滨工业大学（深圳）开源技术协会简介、服务、产品与联系方式。"
>
  <div class="py-14">
    <h1 class="ui-mono text-xs tracking-widest text-muted-fg">
      ABOUT / 关于我们
    </h1>

    <div class="mt-8 max-w-2xl">
      <p class="text-lg leading-relaxed text-page-fg">
        哈尔滨工业大学（深圳）开源技术协会（HITSZ Open Source Association，OSA）
        是由校内开源爱好者组成的技术社团。
      </p>
      <p class="mt-4 leading-relaxed text-muted-fg">
        我们相信代码应该开放、知识应该共享。我们为师生维护校园开源基础设施，
        也帮助每一位想参与开源的同学迈出第一步，从第一个 issue，到第一个被合并的
        PR。
      </p>
    </div>

    <section class="mt-14">
      <h2
        class="ui-mono text-xs font-semibold tracking-widest text-surface-fg"
      >
        MEMBERS / GitHub 组织成员
      </h2>
      <p class="mt-3 text-sm text-surface-fg/80">
        <a
          href="https://github.com/hitszosa"
          target="_blank"
          rel="noreferrer noopener"
          class="text-primary underline decoration-dotted underline-offset-4"
          >@hitszosa</a
        >
        组织的公开成员
      </p>
      <div class="mt-5 flex max-w-4xl flex-wrap gap-3">
        {githubMembers.map((member) => <GithubMemberCard member={member} />)}
      </div>
    </section>

    <!-- 在运营的服务与产品 -->
    <section class="mt-14">
      <h2 class="ui-mono text-xs tracking-widest text-muted-fg">
        SERVICES &amp; PRODUCTS / 我们在运营与维护
      </h2>
      <ul class="mt-7 max-w-2xl space-y-1">
        {
          services.map((item) => (
            <li>
              <a
                href={item.data.href}
                target="_blank"
                rel="noreferrer noopener"
                class="group flex items-center justify-between gap-3 rounded-lg px-3 py-2.5 no-underline hover:bg-surface"
              >
                <span class="flex min-w-0 items-center gap-3">
                  <span
                    class="ui-mono shrink-0 rounded px-1.5 py-0.5 text-[10px]"
                    style={
                      item.data.category === "service"
                        ? "background: color-mix(in srgb, var(--ui-success, var(--ui-secondary)) 14%, transparent); color: var(--ui-success, var(--ui-secondary));"
                        : "background: color-mix(in srgb, var(--ui-primary) 14%, transparent); color: var(--ui-primary);"
                    }
                  >
                    {item.data.category === "service" ? "服务" : "项目"}
                  </span>
                  <span class="font-medium text-surface-fg group-hover:text-primary">
                    {item.data.name}
                  </span>
                </span>
                <span class="ui-mono shrink-0 text-xs text-muted-fg">
                  {item.data.scope === "campus"
                    ? "校内 "
                    : item.data.status === "developing"
                      ? "开发中 "
                      : item.data.status === "beta"
                        ? "Beta "
                        : ""}
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 加入我们 -->
    <section class="mt-14">
      <h2 class="ui-mono text-xs tracking-widest text-muted-fg">
        JOIN / 加入我们
      </h2>
      <p class="mt-6 max-w-2xl leading-relaxed text-muted-fg">
        无论你是零基础的萌新，还是身经百战的老鸟，只要对开源有兴趣，都欢迎。
        我们没有面试，只有一起折腾的热情。
      </p>
      <div class="ui-mono mt-7 flex flex-wrap gap-3 text-sm">
        {
          socialLinks.map(({ href, label, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 rounded-md border border-surface-border bg-surface px-4 py-2.5 text-surface-fg no-underline transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:text-primary"
            >
              <span aria-hidden="true" class="inline-flex shrink-0">
                <iconify-icon icon={icon} class="text-base" />
              </span>
              <span>{label}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 常用校园资源 -->
    <section class="mt-14">
      <h2 class="ui-mono text-xs tracking-widest text-muted-fg">
        CAMPUS / 常用校园资源
      </h2>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          campusResources.map(({ name, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noreferrer noopener"
              class="ui-mono rounded-md border border-surface-border bg-surface px-4 py-2 text-sm text-muted-fg no-underline transition-colors hover:border-primary/40 hover:text-primary"
            >
              {name}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
