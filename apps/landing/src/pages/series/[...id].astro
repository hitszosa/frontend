---
import type { CollectionEntry } from 'astro:content';
import SeriesPage from '../../components/SeriesPage.astro';
import EventPage from '../../components/EventPage.astro';
import { getSeriesData, type SeriesEntry } from '../../lib/series';
import { contentPath } from '../../lib/content';
export async function getStaticPaths() {
  const data = await getSeriesData();
  return [...data.series, ...data.lessons].map((entry) => ({
    params: { id: contentPath(entry.id) }, props: { entry },
  }));
}
interface Props { entry: SeriesEntry | CollectionEntry<'lessons'>; }
const { entry } = Astro.props;
---
{entry.collection === 'series' ? <SeriesPage series={entry} /> : <EventPage event={entry} />}
