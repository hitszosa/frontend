---
import { getCollection } from 'astro:content';
import SiteLayout from '@hitszosa/ui/components/SiteLayout.astro';

interface Props {
  title?: string;
  description?: string;
  immersive?: boolean;
  motionMode?: 'children' | 'marked';
  motionHeroDelay?: number;
}

const {
  title,
  description,
  immersive = false,
  motionMode = 'children',
  motionHeroDelay = 0,
} = Astro.props;
const services = (await getCollection('services', ({ data }) => !data.hide))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    name: entry.data.name,
    href: entry.data.href,
    category: entry.data.category,
    featured: entry.data.featured,
  }));
---

<SiteLayout
  activeSite="landing"
  title={title}
  description={description}
  immersive={immersive}
  services={services}
>
  <div
    class:list={[
      'landing-motion-root',
      motionMode === 'marked' ? 'contents' : 'w-full',
    ]}
    data-landing-motion
    data-landing-motion-items={motionMode}
    data-landing-motion-hero-delay={motionHeroDelay || undefined}
  >
    <slot />
  </div>
</SiteLayout>

<script>
const setupLandingMotion = () => {
  const roots = document.querySelectorAll<HTMLElement>('[data-landing-motion]');

  for (const root of roots) {
    if (root.dataset.motionInitialized === 'true') continue;
    root.dataset.motionInitialized = 'true';

    const automaticallyMarkItems =
      root.dataset.landingMotionItems === 'children';
    const items = Array.from(
      root.querySelectorAll<HTMLElement>(
        automaticallyMarkItems
          ? ':scope > :first-child > *'
          : '[data-landing-reveal]',
      ),
    );
    if (automaticallyMarkItems) {
      for (const item of items) item.dataset.landingReveal = '';
    }

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      for (const item of items) item.classList.add('is-visible');
      continue;
    }

    root.classList.add('landing-motion-ready');
    const sequenceStartedAt = performance.now();
    const heroDelay = Number(root.dataset.landingMotionHeroDelay ?? 0);
    const delayForHero = heroDelay > 0 && window.scrollY <= 1;
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleItems = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              a.target.getBoundingClientRect().top -
              b.target.getBoundingClientRect().top,
          );

        for (const [index, entry] of visibleItems.entries()) {
          const item = entry.target as HTMLElement;
          const heroTimeRemaining = delayForHero
            ? Math.max(0, heroDelay - (performance.now() - sequenceStartedAt))
            : 0;
          const sequenceDelay = automaticallyMarkItems
            ? Math.min(index, 5) * 60 + 80
            : item.hasAttribute('data-landing-sequence')
              ? Math.min(index, 5) * 60
              : 0;
          item.style.setProperty(
            '--landing-initial-reveal-delay',
            `${Math.round(heroTimeRemaining + sequenceDelay)}ms`,
          );
          item.classList.add('is-visible');
          observer.unobserve(item);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );

    for (const item of items) observer.observe(item);
    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      {
        once: true,
      },
    );
  }
};

setupLandingMotion();
document.addEventListener('astro:page-load', setupLandingMotion);
</script>

<style is:global>
.landing-link {
  color: var(--ui-primary);
  text-decoration: none;
}

.landing-link-label {
  text-decoration-line: underline;
  text-decoration-style: dotted;
  text-decoration-color: transparent;
  text-underline-offset: 0.25rem;
  transition: text-decoration-color 200ms ease;
}

.landing-link:hover .landing-link-label,
.landing-link:focus-visible .landing-link-label {
  text-decoration-color: currentColor;
}

.landing-action {
  text-decoration: none;
  transition:
    translate 200ms ease,
    color 200ms ease,
    background-color 200ms ease,
    border-color 200ms ease,
    box-shadow 200ms ease;
}

.landing-action:hover {
  translate: 0 -0.125rem;
}

.landing-action:focus-visible,
.landing-link:focus-visible,
.landing-surface:focus-visible {
  outline: 2px solid var(--ui-primary);
  outline-offset: 2px;
}

.landing-surface {
  border: 1px solid var(--ui-surface-border);
  background: var(--ui-surface);
  transition:
    translate 300ms ease,
    border-color 300ms ease,
    box-shadow 300ms ease;
  will-change: translate;
}

.landing-surface:hover,
.landing-surface:focus-within {
  border-color: color-mix(in srgb, var(--ui-primary) 50%, transparent);
  box-shadow:
    0 4px 6px -1px rgb(0 0 0 / 10%),
    0 2px 4px -2px rgb(0 0 0 / 10%);
  translate: 0 -0.125rem;
}

.landing-motion-root.landing-motion-ready [data-landing-reveal] {
  opacity: 0;
  transform: translateY(1.25rem);
}

.landing-motion-root.landing-motion-ready [data-landing-reveal].is-visible {
  animation: landing-page-reveal 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: calc(
    var(--landing-reveal-delay, 0ms) +
    var(--landing-initial-reveal-delay, 0ms)
  );
}

.landing-motion-root.landing-motion-ready
  [data-landing-stagger][data-landing-reveal]
  > *,
.landing-motion-root.landing-motion-ready
  [data-landing-reveal]
  [data-landing-stagger]
  > * {
  opacity: 0;
  transform: translateY(0.65rem);
}

.landing-motion-root.landing-motion-ready
  [data-landing-stagger][data-landing-reveal].is-visible
  > *,
.landing-motion-root.landing-motion-ready
  [data-landing-reveal].is-visible
  [data-landing-stagger]
  > * {
  animation: landing-stagger-reveal 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes landing-page-reveal {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes landing-stagger-reveal {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

[data-landing-stagger] > :nth-child(2) {
  animation-delay: 55ms;
}

[data-landing-stagger] > :nth-child(3) {
  animation-delay: 110ms;
}

[data-landing-stagger] > :nth-child(4) {
  animation-delay: 165ms;
}

[data-landing-stagger] > :nth-child(5) {
  animation-delay: 220ms;
}

[data-landing-stagger] > :nth-child(n + 6) {
  animation-delay: 275ms;
}

@media (prefers-reduced-motion: reduce) {
  .landing-action,
  .landing-surface {
    transition: none;
  }

  .landing-action:hover,
  .landing-surface:hover,
  .landing-surface:focus-within {
    translate: none;
  }

  .landing-motion-root [data-landing-reveal],
  .landing-motion-root [data-landing-stagger] > * {
    animation: none;
    opacity: 1;
    transform: none;
  }
}
</style>
