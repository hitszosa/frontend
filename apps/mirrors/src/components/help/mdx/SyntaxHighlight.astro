---
interface Props {
  code: string
  language?: string
  meta?: string
}

const { language = 'text', meta } = Astro.props
---

<section
  class="not-prose my-6 overflow-hidden rounded-lg border border-surface-border bg-surface"
>
  <header
    class="flex min-h-10 items-center gap-2 border-b border-surface-border px-4 py-2 text-xs text-muted-fg"
  >
    <span class="ui-mono uppercase">{language}</span>
    {meta && <span>{meta}</span>}
  </header>
  <pre
    class="m-0 overflow-x-auto bg-inset p-4 text-sm leading-6 text-surface-fg"
  ><code>{Astro.props.code}</code></pre>
</section>
