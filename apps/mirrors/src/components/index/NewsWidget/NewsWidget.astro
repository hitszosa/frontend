---
import SectionHeading from "../../base/SectionHeading.astro";
import { Icon } from "astro-icon/components";
import type { ArticleDigest } from "../../news/ArticleDigest";
import NewsWidgetItem from "./NewsWidgetItem.astro";

interface Props {
  digests: ArticleDigest[];
}

const { digests } = Astro.props;
---

<section class="space-y-4">
  <SectionHeading>
    <Icon slot="icon" name="icon-park-outline:newspaper-folding" />
    Recent News
  </SectionHeading>
  <div class="space-y-1 rounded-lg border border-surface-border bg-surface p-4">
    <ul class="divide-y divide-surface-border">
      {digests.map((digest) => <NewsWidgetItem digest={digest} />)}
    </ul>
    <a
      href="https://www.osa.moe/updates/"
      class="group ml-auto flex w-fit items-center gap-2 rounded-sm text-sm font-medium text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary hocus:text-osa-hover"
    >
      Read More
      <span
        class="transition-transform group-hover:translate-x-0.5 group-focus-visible:translate-x-0.5"
      >
        →
      </span>
    </a>
  </div>
</section>
