---
import type { ArticleDigest } from '../../news/ArticleDigest'

interface Props {
  digest: ArticleDigest
}

const { digest } = Astro.props
const dateTime = new Date(digest.date).toISOString()
const dateString = dateTime.slice(0, 10)
---

<li
  class="flex items-center justify-between gap-4 py-2 text-muted-fg first:pt-0"
>
  <div class="flex min-w-0 items-center text-page-fg text-[15px]">
    <a
      href={digest._path}
      class="relative inline-block truncate decoration-dotted underline-offset-4 transition-colors hocus:cursor-pointer hocus:text-primary hocus:underline"
    >
      {digest.title}
    </a>
  </div>
  <div class="flex shrink-0 self-stretch items-center text-sm">
    <relative-time
      datetime={dateTime}
      format="relative"
      lang="en"
      class="inline-block whitespace-nowrap"
    >
      {dateString}
    </relative-time>
  </div>
</li>

<script>
import '@github/relative-time-element'
</script>
