---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import SiteFooter from '@hitszosa/ui/components/SiteFooter.astro'
import SiteHeader from '@hitszosa/ui/components/SiteHeader.astro'

interface Props {
  title?: string
}

const { title = 'HITSZ OSA Mirrors' } = Astro.props
const currentPath = Astro.url.pathname
---

<!doctype html>
<html
  lang="zh-CN"
  data-default-theme-mode="system"
  data-theme-storage-key="theme-preference"
>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta
      name="description"
      content="哈尔滨工业大学（深圳）开源技术协会开源软件镜像站"
    >
    <script>
    import '@hitszosa/ui/client/theme-init'
    </script>
  </head>
  <body
    class="ui-sans m-0 flex min-h-screen flex-col bg-page-bg text-page-fg transition-colors duration-300 ease-in-out"
  >
    <ClientRouter />
    <SiteHeader activeSite="mirrors" currentPath={currentPath} />

    <main
      class="mx-auto flex w-full max-w-screen-xl flex-1 justify-around px-6 pt-28 pb-12 md:px-12"
    >
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
