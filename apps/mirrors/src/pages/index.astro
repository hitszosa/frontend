---
import Layout from '@hitszosa/ui/components/SiteLayout.astro'
import MirrorList from '@components/index/MirrorList/MirrorList.vue'
import DownloadWidget from '@components/index/DownloadWidget/DownloadWidget.astro'
import NewsWidget from '@components/index/NewsWidget/NewsWidget.astro'
import {
  getMirrorNews,
  sortNewsByDateDesc,
  toArticleDigest,
} from '../utils/news'
import SectionHeading from '@components/base/SectionHeading.astro'
import { Icon } from 'astro-icon/components'

const news = sortNewsByDateDesc(await getMirrorNews())
  .map(toArticleDigest)
  .slice(0, 3)
---

<Layout activeSite="mirrors">
  <div
    class="flex w-full flex-col lg:items-start lg:flex-row lg:space-x-8 lg:space-x-12"
  >
    <div class="min-w-0 grow space-y-4 lg:order-first">
      <SectionHeading>
        <Icon slot="icon" name="icon-park-outline:dropbox" />
        Index of Mirrors
      </SectionHeading>
      <MirrorList client:load />
    </div>
    <div
      class="order-first flex h-min lg:min-w-[18em] flex-col space-y-8 lg:space-y-10 mb-8 lg:order-last lg:sticky lg:top-24 lg:w-[32%] lg:max-w-[30em]"
    >
      <a
        href="/help/"
        class="group flex items-center justify-between rounded-lg border border-primary/30 bg-primary/5 px-4 py-3 text-sm no-underline transition-colors hover:border-primary hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      >
        <span class="flex items-center gap-2 font-medium text-primary">
          <Icon name="icon-park-outline:help" />
          <span>帮助 · 镜像使用帮助</span>
        </span>
        <span
          aria-hidden="true"
          class="text-primary transition-transform group-hover:translate-x-1"
        >
          →
        </span>
      </a>
      <DownloadWidget />
      <NewsWidget digests={news} />
    </div>
  </div>
</Layout>
