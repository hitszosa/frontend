---
import SiteFooter from '@hitszosa/ui/components/SiteFooter.astro'
import HelpSidebar from '@components/help/HelpSidebar.vue'
import HelpCoverageStat from '@components/help/HelpCoverageStat.vue'
import Layout from '@hitszosa/ui/components/SiteLayout.astro'
import { helpManifest } from '@/utils/help'

const commonPageIds = [
  'ubuntu',
  'debian',
  'archlinux',
  'docker-ce',
  'pypi',
  'homebrew',
  'rustup',
  'nix',
] as const

const routeByCname = new Map(
  helpManifest.routes.map((route) => [route.cname, route]),
)
const commonRoutes = commonPageIds
  .map((pageId) => routeByCname.get(pageId))
  .filter((route): route is NonNullable<typeof route> => route !== undefined)
---

<Layout
  activeSite="mirrors"
  title="镜像使用帮助 | HITSZ OSA Mirrors"
  description="HITSZ OSA 镜像站常用软件源配置与使用帮助。"
  immersive
>
  <div
    class="grid h-full min-h-0 w-full grid-cols-1 md:grid-cols-[18rem_minmax(0,1fr)]"
  >
    <aside
      class="hidden min-h-0 overflow-hidden border-r border-surface-border bg-surface md:block"
    >
      <HelpSidebar client:load transition:persist activePageId="" />
    </aside>

    <section
      id="help-article-scroll"
      class="min-h-0 overflow-y-auto overscroll-contain scroll-smooth bg-page-bg"
    >
      <div
        class="mx-auto w-full min-h-4/5 max-w-5xl px-6 pt-7 pb-4 md:px-10 md:pt-10 lg:px-14"
      >
        <div class="mb-8 md:hidden">
          <label
            for="mobile-help-page"
            class="mb-2 block text-sm font-medium text-surface-fg"
          >
            镜像使用帮助
          </label>
          <select
            id="mobile-help-page"
            class="h-11 w-full rounded-lg border border-surface-border bg-surface px-3 text-surface-fg outline-none focus:border-primary focus:ring-2 focus:ring-primary"
          >
            <option value="/help/" selected>帮助首页</option>
            {helpManifest.routes.map((item) => (
              <option value={`/help/${item.slug}/`}>{item.title}</option>
            ))}
          </select>
        </div>

        <article
          class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
        >
          <header class="not-prose mb-10 border-b border-surface-border pb-7">
            <div class="flex items-start justify-between gap-4">
              <p
                class="ui-mono m-0 text-xs tracking-[0.18em] text-primary uppercase"
              >
                Mirror Help
              </p>
              <a
                href="/"
                class="inline-flex shrink-0 items-center gap-1 text-sm text-muted-fg no-underline transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                <span aria-hidden="true">←</span>
                <span>主页</span>
              </a>
            </div>
            <h1
              class="mt-6 mb-0 text-3xl font-semibold tracking-tight text-surface-fg md:text-4xl"
            >
              镜像使用帮助
            </h1>
            <p class="mt-3 mb-0 text-sm leading-7 text-muted-fg md:text-base">
              HITSZ OSA 镜像站的软件源配置方法、包管理器设置和常用命令。
            </p>
            <div class="mt-5">
              <HelpCoverageStat client:load />
            </div>
          </header>

          <section
            aria-labelledby="common-help-heading"
            class="not-prose space-y-6"
          >
            <div class="flex flex-wrap items-end justify-between gap-4">
              <h2
                id="common-help-heading"
                class="flex items-center gap-1.5 text-2xl font-medium text-surface-fg"
              >
                <span aria-hidden="true">★</span>
                <span>常用文档</span>
              </h2>
              <span class="text-sm text-muted-fg"
                >从这里开始配置你的软件源</span
              >
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {commonRoutes.map((route) => (
                <a
                  href={`/help/${route.slug}/`}
                  class="group flex min-h-32 flex-col justify-between rounded-lg border border-surface-border bg-surface p-5 no-underline shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                >
                  <span class="flex items-start justify-between gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-lg text-primary">
                      {route.title.slice(0, 1)}
                    </span>
                    <span
                      aria-hidden="true"
                      class="text-muted-fg transition-transform group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </span>
                  <span class="mt-6">
                    <span class="block font-medium text-surface-fg transition-colors group-hover:text-primary">
                      {route.title}
                    </span>
                    <span class="ui-mono mt-1 block text-xs text-muted-fg">
                      /help/{route.slug}/
                    </span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        </article>
      </div>

      <SiteFooter class="mx-auto max-w-5xl" />
    </section>
  </div>
</Layout>

<script>
const bindMobileHelpSelect = () => {
  const select = document.querySelector<HTMLSelectElement>('#mobile-help-page')
  select?.addEventListener('change', () => {
    window.location.href = select.value
  })
}

document.addEventListener('astro:page-load', bindMobileHelpSelect)
</script>
