---
import { render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { getMirrorNews } from '../../lib/news'

export async function getStaticPaths() {
  const news = await getMirrorNews()

  return news.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Layout title={`${entry.data.title} | HITSZ OSA Mirrors`}>
  <article
    class="flex flex-col w-full max-w-screen-lg prose dark:prose-invert prose-slate"
  >
    <header class="not-prose mb-10 border-b border-surface-border pb-8">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-muted-fg">
        <time datetime={entry.data.date.toISOString()}>
          {new Intl.DateTimeFormat('zh-CN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            }).format(entry.data.date)}
        </time>
        {entry.data.tags.map((tag) => <span>#{tag}</span>)}
      </div>
      <h1 class="text-3xl font-semibold text-surface-fg md:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-4 text-base leading-7 text-muted-fg">
        {entry.data.summary}
      </p>
    </header>
    <Content />
  </article>
</Layout>
