---
interface Props {
  name: string;
  url: string;
}

const { name, url } = Astro.props;
---

<a class="no-underline mx-[0.6em] mb-[1.2em]" href={url} title={url}>
  <div
    class="will-change-transform transition-all duration-300 ease-in-out whitespace-nowrap bg-white rounded-[20px] flex justify-center items-center text-center h-[50px] w-auto [box-shadow:rgba(0,0,0,0.1)_0px_4px_6px_-1px,rgba(0,0,0,0.06)_0px_2px_4px_-1px] hover:translate-y-[-3px] hover:scale-[1.01] hover:text-accent-800 hover:[box-shadow:rgba(0,0,0,0.12)_0px_6px_8px_-1px,rgba(0,0,0,0.08)_0px_4px_6px_-1px]"
  >
    <span class="mx-6">{name}</span>
  </div>
</a>
