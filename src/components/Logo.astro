---
interface Props {
  logos: {
    src: string;
    alt: string;
  }[];
  defaultLogo?: number;
}

const { logos, defaultLogo = 0 } = Astro.props;
---

<style>
  img.logo {
    grid-area: 1 / 1;
    opacity: 0;
    filter: drop-shadow(0px 18px 9px rgba(0, 0, 0, 0.07)) blur(15px) contrast(3);
    transition: all 0.7s ease-in-out;
    will-change: transform;
  }

  img.logo.primary {
    opacity: 100%;
    filter: drop-shadow(0px 18px 9px rgba(0, 0, 0, 0.07));
    z-index: 2;
  }

  img.logo.primary:hover {
    transform: rotate(8deg);
    filter: drop-shadow(0px 12px 6px rgba(0, 0, 0, 0.07));
  }

  @keyframes hover-jitter {
    0% {
      transform: translate(0, 0);
    }
    20% {
      transform: translate(-1px, 1px);
    }
    40% {
      transform: translate(1px, -1px);
    }
    60% {
      transform: translate(-1px, -1px);
    }
    80% {
      transform: translate(1px, 1px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
</style>

{
  logos.map((logo, index) => (
    <img
      class:list={['logo', { primary: index === defaultLogo }]}
      src={logo.src}
      alt={logo.alt}
    />
  ))
}
