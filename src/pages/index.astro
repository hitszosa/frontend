---
import { osaLogoAlt, osaLogoPub, osaLogoVtuber } from '@hitszosa/ui';
import LinkButton from '../components/LinkButton.astro';
import Logo from '../components/Logo.astro';
import Layout from '../layouts/Layout.astro';

const logos = [osaLogoPub, osaLogoAlt, osaLogoVtuber];
const defaultLogo =
  Math.random() < 0.1 ? Math.floor(Math.random() * (logos.length - 1) + 1) : 0; // 小概率切换到其他logo

const linkSections = [
  {
    title: '协会公共资源',
    links: [
      { name: 'OSA Wiki', href: 'https://wiki.osa.moe' },
      {
        name: 'Awesome HITSZ',
        href: 'https://github.com/hitszosa/awesome-hitsz/blob/main/README.md',
      },
      { name: 'Weekly', href: 'https://weekly.hitsz.org' },
    ],
  },
  {
    title: '协会校园网资源',
    links: [
      { name: '开源软件镜像站', href: 'http://mirrors.osa.moe' },
      { name: '开源软件镜像站 (IPV6)', href: 'http://mirrors6.osa.moe' },
    ],
  },
  {
    title: '学校校园网资源',
    links: [
      { name: 'Grader', href: 'https://grader.hitsz.edu.cn/' },
      { name: '上网认证', href: 'http://10.248.98.2/' },
      { name: '课程录播平台', href: 'http://219.223.238.14:88/ve/' },
    ],
  },
];

const footerLinks = [
  { name: 'Github', href: 'https://github.com/hitszosa' },
  {
    name: 'QQ Group',
    href: 'https://qm.qq.com/cgi-bin/qm/qr?k=EmOyWeZrOaOeSoVrVLoozyKYdvjOia_t',
  },
  { name: 'Bilibili', href: 'https://space.bilibili.com/1124374292' },
];
---

<Layout>
  <div class="group logo-view flex items-center justify-center gap-[1em]">
    <button
      class="opacity-0 group-hover:opacity-100 group-hover:cursor-pointer rounded-full w-8 h-8 text-slate-400 bg-transparent border-none transition-all duration-300 ease-in-out"
      >⏴</button
    >
    <a
      class="grid grid-cols-[224px] grid-rows-[224px]"
      href="https://www.osa.moe/"
      aria-label="HITSZ OSA Homepage"
    >
      <Logo logos={logos} defaultLogo={defaultLogo} />
    </a>
    <button
      class="opacity-0 group-hover:opacity-100 group-hover:cursor-pointer rounded-full w-8 h-8 text-slate-400 bg-transparent border-none transition-all duration-300 ease-in-out"
      >⏵</button
    >
  </div>

  <h1
    class="group font-bold will-change-transform transition-all duration-300 ease-in-out mt-[1.2em] mb-[3em] mx-auto text-[1.8em] text-osa-300 drop-shadow-[0px_8px_9px_rgba(0,0,0,0.2)] whitespace-nowrap w-fit text-center hover:text-secondary hover:translate-y-[3px] hover:drop-shadow-[0px_12px_6px_rgba(0,0,0,0.25)]"
  >
    HITSZ <ruby
      >开源技术协会<rp> </rp><rt
        class="opacity-0 group-hover:opacity-100 transition-all duration-600 ease-out"
        >Open Source Association</rt
      ></ruby
    >
  </h1>

  {
    linkSections.map((section, index) => (
      <>
        <h2 class="mt-[2em] mb-[1.6em] mx-auto text-[1.2em] font-bold text-osa-300 w-fit">
          {section.title}
        </h2>
        <div class="flex flex-wrap justify-center text-base">
          {section.links.map((link) => (
            <LinkButton name={link.name} url={link.href} />
          ))}
        </div>
        {index < linkSections.length - 1 && (
          <hr class="will-change-transform transition-[border-color] duration-300 border-t-2 border-dotted border-slate-200 mt-[2.8em] mb-[3.8em] hover:border-accent-100" />
        )}
      </>
    ))
  }

  <footer class="mt-[8em] mb-[2em] text-center text-[0.76em] text-slate-400">
    <p class="my-[1em] leading-normal">HITSZ OSA Copyleft 2024</p>
    <p class="my-[1em] leading-normal">
      {
        footerLinks.map(({ name, href }, idx) => (
          <>
            <a
              class="will-change-transform transition-all duration-300 ease-in-out text-inherit no-underline hover:text-osa-300"
              href={href}
            >
              {name}
            </a>
            {idx < footerLinks.length - 1 && <span class="mx-[0.8rem]">·</span>}
          </>
        ))
      }
    </p>
    <p class="console-easter-egg my-[1em] leading-normal">
      More infomation in browser console
    </p>
  </footer>
</Layout>

<script>
  console.info('Welcome to the pub!');
  console.info('Check out TXT record of tg.osa.moe');

  let logoIndex = 0;
  const $logos = document.querySelectorAll<HTMLImageElement>('img.logo');
  const [$prevButton, $nextButton] =
    document.querySelectorAll<HTMLButtonElement>('.logo-view > button');

  const updateLogos = () => {
    $logos.forEach((logo, index) => {
      if (index === logoIndex) {
        logo.classList.add('primary');
      } else {
        logo.classList.remove('primary');
      }
    });
  };

  $prevButton.addEventListener('click', () => {
    logoIndex = (logoIndex - 1 + $logos.length) % $logos.length;
    updateLogos();
  });

  $nextButton.addEventListener('click', () => {
    logoIndex = (logoIndex + 1) % $logos.length;
    updateLogos();
  });
</script>
