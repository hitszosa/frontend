{
  "name": "@hitszosa/frontend",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@astrojs/check": "^0.9.9",
      "@biomejs/biome": "^2.5.6",
      "@eslint/js": "^9.39.4",
      "@typescript-eslint/eslint-plugin": "^8.59.1",
      "@typescript-eslint/parser": "^8.59.1",
      "astro": "^6.2.1",
      "eslint": "^9.39.4",
      "eslint-plugin-astro": "^1.7.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^5.9.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mock": "MOCK=true turbo run dev",
    "dev:landing": "turbo run dev --filter=@hitszosa/landing...",
    "dev:landing:mock": "MOCK=true turbo run dev --filter=@hitszosa/landing...",
    "dev:mirrors": "turbo run dev --filter=@hitszosa/mirrors...",
    "dev:mirrors:mock": "MOCK=true turbo run dev --filter=@hitszosa/mirrors...",
    "build": "turbo run build",
    "build:mock": "MOCK=true turbo run build",
    "build:landing": "turbo run build --filter=@hitszosa/landing...",
    "build:landing:mock": "MOCK=true turbo run build --filter=@hitszosa/landing...",
    "build:mirrors": "turbo run build --filter=@hitszosa/mirrors...",
    "build:mirrors:mock": "MOCK=true turbo run build --filter=@hitszosa/mirrors...",
    "lint": "turbo run lint",
    "check": "turbo run check && bun run check:packages",
    "check:packages": "sherif",
    "format": "turbo run format",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "sherif": "1.13.0",
    "turbo": "^2.5.0"
  }
}
