{
  "name": "@hitszosa/mirrorz-parser",
  "private": true,
  "description": "Framework-neutral mirrorz-docs parser and template compiler.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint src tests eslint.config.mjs",
    "lint:fix": "eslint src tests eslint.config.mjs --fix",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "markdown-it": "^13.0.0",
    "markdown-it-myst": "^1.0.15",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.0",
    "mdast-util-to-string": "^4.0.0",
    "myst-parser": "^1.6.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@eslint/js": "catalog:",
    "@hitszosa/eslint-config": "workspace:*",
    "@mdx-js/mdx": "^3.1.0",
    "@types/bun": "^1.3.10",
    "@types/markdown-it": "^13.0.0",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
