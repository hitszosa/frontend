---
import Tooltip from './Tooltip.vue'
import { formatLocalDate, type DateInput } from '../utils/time'

interface Props {
  value: DateInput
  hover?: boolean
  tooltipAlign?: 'center' | 'start' | 'end'
  class?: string
}

const {
  value,
  hover = false,
  tooltipAlign = 'center',
  class: className,
} = Astro.props
const date = value instanceof Date ? value : new Date(value)
const fullDate = formatLocalDate(date)
---

{hover ? (
  <Tooltip
    client:load
    content={fullDate}
    placement="top"
    align={tooltipAlign}
  >
    <time datetime={date.toISOString()} data-relative-date class={className}>{fullDate}</time>
  </Tooltip>
) : (
  <time datetime={date.toISOString()} data-relative-date class={className}>{fullDate}</time>
)}

<script>
import { formatRelativeDate } from '../utils/time'

const updateRelativeDates = () => {
  document
    .querySelectorAll<HTMLTimeElement>('time[data-relative-date]')
    .forEach((time) => {
      if (!time.dateTime) return
      time.textContent = formatRelativeDate(time.dateTime)
    })
}

document.addEventListener('astro:page-load', updateRelativeDates)
window.setInterval(updateRelativeDates, 60_000)
</script>
