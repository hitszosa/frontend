---
interface Props {
  size?: 'sm' | 'md' | 'lg'
  defaultMode?: 'light' | 'dark' | 'system'
  storageKey?: string
  class?: string
}

const {
  size = 'md',
  defaultMode = 'system',
  storageKey = 'theme-preference',
  class: className = '',
} = Astro.props

const sizeClasses = {
  sm: {
    button: 'h-10 w-10',
    icon: 'text-base',
  },
  md: {
    button: 'h-9 w-9',
    icon: 'text-lg',
  },
  lg: {
    button: 'h-10 w-10',
    icon: 'text-xl',
  },
} as const

const currentSize = sizeClasses[size]
---

<theme-toggle
  class={className}
  data-default-mode={defaultMode}
  data-storage-key={storageKey}
>
  <button
    class:list={[
      'theme-toggle inline-flex items-center justify-center leading-none rounded-full border border-transparent bg-surface/75 text-muted-fg shadow-[rgba(0,0,0,0.06)_0px_2px_8px_-4px] backdrop-blur-sm transition-all duration-300 ease-in-out hover:-translate-y-[1px] hover:border-surface-border hover:bg-surface hover:text-primary focus-visible:border-surface-border focus-visible:outline-2 focus-visible:outline-primary hover:cursor-pointer',
      currentSize.button,
    ]}
    type="button"
    aria-label="切换主题模式"
    title="切换主题模式"
  >
    <iconify-icon
      class:list={['block leading-none', currentSize.icon]}
      style="display:block"
      icon="material-symbols:light-mode"
      aria-hidden="true"
    ></iconify-icon>
  </button>
</theme-toggle>

<script>
import 'iconify-icon'
import {
  applyTheme,
  cycleThemeMode,
  getStoredThemeMode,
  saveThemeMode,
  isThemeMode,
  themeIcons,
} from '../client/theme'
import type { ThemeMode } from '../client/theme'

class OsaThemeToggleElement extends HTMLElement {
  private media: MediaQueryList | null = null
  private handleClick: (() => void) | null = null
  private handleSystemThemeChange: (() => void) | null = null

  connectedCallback() {
    const button = this.querySelector('.theme-toggle')
    const icon = this.querySelector('iconify-icon')
    const storageKey = this.dataset.storageKey ?? 'theme-preference'
    const defaultMode = isThemeMode(this.dataset.defaultMode)
      ? this.dataset.defaultMode
      : 'system'

    const syncActiveState = (mode: ThemeMode) => {
      const modeLabels: Record<ThemeMode, string> = {
        light: '浅色',
        dark: '深色',
        system: '跟随系统',
      }
      icon?.setAttribute('icon', themeIcons[mode] ?? themeIcons.system)
      button?.setAttribute('data-mode', mode)
      button?.setAttribute(
        'aria-label',
        `当前为${modeLabels[mode]}主题。点击切换主题模式`,
      )
      button?.setAttribute('title', `当前主题：${modeLabels[mode]}`)
    }

    const savedMode = getStoredThemeMode(storageKey, defaultMode)

    applyTheme(savedMode)
    syncActiveState(savedMode)

    this.handleClick = () => {
      const currentMode = getStoredThemeMode(storageKey, defaultMode)
      const nextMode = cycleThemeMode(currentMode)

      saveThemeMode(nextMode, storageKey)
      applyTheme(nextMode)
      syncActiveState(nextMode)
    }
    button?.addEventListener('click', this.handleClick)

    this.media = window.matchMedia('(prefers-color-scheme: dark)')
    this.handleSystemThemeChange = () => {
      const mode = getStoredThemeMode(storageKey, defaultMode)
      if (mode === 'system') {
        applyTheme(mode)
        syncActiveState(mode)
      }
    }
    this.media.addEventListener('change', this.handleSystemThemeChange)
  }

  disconnectedCallback() {
    const button = this.querySelector('.theme-toggle')
    if (this.handleClick) button?.removeEventListener('click', this.handleClick)
    if (this.handleSystemThemeChange) {
      this.media?.removeEventListener('change', this.handleSystemThemeChange)
    }
  }
}

if (!customElements.get('theme-toggle')) {
  customElements.define('theme-toggle', OsaThemeToggleElement)
}
</script>
