---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'footer'> {
  showConsoleHint?: boolean
}

const { class: className, showConsoleHint = true, ...props } = Astro.props

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/hitszosa' },
  {
    name: 'QQ 群',
    href: 'https://qm.qq.com/cgi-bin/qm/qr?k=EmOyWeZrOaOeSoVrVLoozyKYdvjOia_t',
  },
  { name: 'Bilibili', href: 'https://space.bilibili.com/1124374292' },
]
---

<footer
  {...props}
  class:list={[
    'mt-16 border-t border-surface-border px-6 pt-8 pb-10 text-center text-xs text-muted-fg',
    className,
  ]}
>
  <p class="my-2">
    HITSZ OSA · 哈尔滨工业大学（深圳）开源技术协会 · Copyleft
    {new Date().getFullYear()}
  </p>
  <p class="my-2">
    {socialLinks.map(({ name, href }, index) => (
        <>
          <a
            href={href}
            target="_blank"
            rel="noreferrer noopener"
            class="text-inherit no-underline transition-colors hover:text-primary"
          >
            {name}
          </a>
          {index < socialLinks.length - 1 && <span class="mx-3">·</span>}
        </>
      ))}
  </p>
  {showConsoleHint && (
    <p class="my-2">
      <span class="console-easter-egg inline-block cursor-help">
        More information in browser console
      </span>
    </p>
  )}
</footer>

<script>
console.info('%cWelcome to the pub!', 'color: #B88611')
console.info(
  '%cCheck out TXT record of tg.osa.moe',
  'color: rgb(87, 110, 219);',
)
</script>

<style>
.console-easter-egg:hover {
  animation: console-hint-shake 420ms ease-in-out;
}

@keyframes console-hint-shake {
  0%,
  100% {
    transform: translateX(0) rotate(0);
  }
  20% {
    transform: translateX(-2px) rotate(-1deg);
  }
  40% {
    transform: translateX(2px) rotate(1deg);
  }
  60% {
    transform: translateX(-1px) rotate(-0.5deg);
  }
  80% {
    transform: translateX(1px) rotate(0.5deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .console-easter-egg:hover {
    animation: none;
  }
}
</style>
